# Gym Ontime Express backend: environment variables.
# Copy to `.env` and fill in real values. Never commit `.env`.

PORT=5000

# MongoDB connection string (local MongoDB or Atlas)
MONGO_URI=mongodb://localhost:27017/gym_ontime

# Use a long random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Paystack secret key (test key in development). Never exposed to the client.
PAYSTACK_SECRET_KEY=your-paystack-test-secret-key

# The frontend's address. Paystack redirects to ${FRONTEND_URL}/payment-success
# after checkout. Locally the frontend runs on port 4000 (yarn dev).
FRONTEND_URL=http://localhost:4000

# Cloudinary (signed image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
